# Supabase configuration for local development
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Groq — assistants IA (site public + dashboard)
# Local (proxy Vite) ET production Vercel (Settings → Environment Variables) :
GROQ_API_KEY=gsk_your_groq_api_key
# Optionnel : modèle Groq (défaut llama-3.3-70b-versatile)
VITE_GROQ_MODEL=llama-3.3-70b-versatile
# Ne pas utiliser VITE_GROQ_API_KEY en prod (expose la clé au navigateur).
