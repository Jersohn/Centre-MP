# Supabase configuration for local development
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Groq — assistants IA (site public + dashboard)
# Recommandé en local (proxy Vite /api/ai-chat, clé non exposée au navigateur) :
GROQ_API_KEY=gsk_your_groq_api_key
# Optionnel : modèle Groq (défaut llama-3.3-70b-versatile)
VITE_GROQ_MODEL=llama-3.3-70b-versatile
# Repli pour hébergement statique uniquement (exposé au client — à éviter en prod) :
# VITE_GROQ_API_KEY=gsk_your_groq_api_key
